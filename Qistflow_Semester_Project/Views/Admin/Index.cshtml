@{
    ViewData["Title"] = "Admin Dashboard";
    <style>
        .stat-card {
            border-top: 4px solid var(--green);
        }

        .verification-note {
            padding: 1.5rem;
            background: var(--green);
            color: white;
            border-radius: 14px;
        }

            .verification-note h2 {
                color: white;
            }

        .table th {
            background-color: #f1ebe7;
        }

        .text-bg-warning {
            background-color: #ffdcc3 !important;
            color: #6e3900 !important;
        }

        .card {
            border: 1px solid #eee8e3;
            border-radius: 14px;
        }

        .soft-panel {
            background-color: var(--soft);
            border-radius: 14px;
        }

        .brand-logo {
            width: 174px;
            height: 44px;
            object-fit: contain;
        }

        .logo-mark {
            width: 58px;
            height: 58px;
        }

        .profile-photo {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
        }

        a {
            text-decoration: none;
            color: #003f2e;
        }
    </style>
}
<header>
    <nav class="navbar container gap-3 py-4">
        <a href="@Url.Action("Index", "Admin")">
            <img src="~/assets/logo.svg" class="brand-logo" alt="QistFlow Admin">
        </a>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <a href="@Url.Action("Index", "Admin")" class="btn btn-success">Dashboard</a>
            <a href="#stock">Product Stock</a>
            <a href="#requests">Booking Requests</a>
            <span class="small text-secondary">@(User.Identity?.Name)</span>
            <form asp-area="Identity" asp-page="/Account/Logout" method="post"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="btn btn-success">Log Out</button>
            </form>
        </div>
    </nav>
</header>

<main class="container pb-5">
    <section class="p-4 mb-5">
        <div class="row g-3 align-items-center">
            <div class="col-lg-8">
                <p class="section-label">Store Verification Desk · Sample Data</p>
                <h1>Store Overview &amp; Verification Desk</h1>
                <p class="mb-0">View installment bookings, available stock, and store collection information.</p>
            </div>
            <div class="col-lg-4">
                <div class="bg-white p-3 rounded-3">
                    <i class="bi bi-shop me-2" aria-hidden="true"></i>
                    Example branch: DHA Karachi
                </div>
            </div>
        </div>
    </section>

    <!-- Dashboard summary cards -->
    <div class="row g-4 mb-5">
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card h-100 p-4">
                <p><i class="bi bi-clipboard-check" aria-hidden="true"></i> Pending Requests</p>
                <p class="display-4">2</p>
                <span class="badge text-bg-warning">Requires Review</span>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card h-100 p-4">
                <p><i class="bi bi-box-seam" aria-hidden="true"></i> Available Stock</p>
                <p class="display-4">11</p>
                <p class="small mb-0">Across 4 catalog products</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card h-100 p-4">
                <p><i class="bi bi-lock" aria-hidden="true"></i> Approved &amp; Reserved</p>
                <p class="display-4">1</p>
                <p class="small mb-0">Awaiting customer pickup</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card h-100 p-4">
                <p><i class="bi bi-patch-check" aria-hidden="true"></i> Collected</p>
                <p class="display-4">28</p>
                <p class="small mb-0">Example completed bookings</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-7">
            <section class="card overflow-hidden" id="requests">
                <div class="soft-panel rounded-0 p-4">
                    <h2 class="h5">
                        <i class="bi bi-clipboard-data me-2" aria-hidden="true"></i>
                        Recent Booking Requests
                    </h2>
                    <p class="small mb-0">Sample applicants and booking status</p>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <caption class="px-3">Sample data; no live bookings are stored.</caption>
                        <thead>
                            <tr>
                                <th scope="col">Applicant</th>
                                <th scope="col">Product &amp; Plan</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="p-3">Ali Raza<br><small>QF-8092</small></td>
                                <td>MacBook Air M2<br><small>10 months · Rs. 31,000/month</small></td>
                                <td><span class="badge text-bg-warning">Pending Review</span></td>
                            </tr>
                            <tr>
                                <td class="p-3">Fatima Noor<br><small>QF-8091</small></td>
                                <td>Samsung S24 Ultra<br><small>10 months · Rs. 39,000/month</small></td>
                                <td><span class="badge text-bg-warning">Pending Review</span></td>
                            </tr>
                            <tr>
                                <td class="p-3">Usman Tariq<br><small>QF-8089</small></td>
                                <td>Haier Inverter AC<br><small>10 months · Rs. 18,500/month</small></td>
                                <td><span class="badge text-bg-success">Approved</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="col-xl-5">
            <section class="card p-4 mb-4" id="stock">
                <h2 class="h5 mb-4">
                    <i class="bi bi-clipboard-check me-2" aria-hidden="true"></i>
                    Inventory Stock Watch
                </h2>

                <div class="soft-panel p-3 mb-3 d-flex align-items-center gap-3">
                    <span class="icon-box"><i class="bi bi-laptop" aria-hidden="true"></i></span>
                    <div class="flex-grow-1">MacBook Air M2</div>
                    <strong>4 available</strong>
                </div>

                <div class="soft-panel p-3 mb-3 d-flex align-items-center gap-3">
                    <span class="icon-box"><i class="bi bi-phone" aria-hidden="true"></i></span>
                    <div class="flex-grow-1">Samsung S24 Ultra</div>
                    <strong>2 available</strong>
                </div>

                <div class="soft-panel p-3 mb-3 d-flex align-items-center gap-3">
                    <span class="icon-box"><i class="bi bi-fan" aria-hidden="true"></i></span>
                    <div class="flex-grow-1">Haier Inverter AC</div>
                    <strong>5 available</strong>
                </div>

                <div class="soft-panel p-3 d-flex align-items-center gap-3">
                    <span class="icon-box"><i class="bi bi-controller" aria-hidden="true"></i></span>
                    <div class="flex-grow-1">Sony PlayStation 5</div>
                    <strong class="text-danger">Out of stock</strong>
                </div>
            </section>

            <aside class="verification-note">
                <h2 class="h6">
                    <i class="bi bi-shield-check me-2" aria-hidden="true"></i>
                    MANUAL VERIFICATION REMINDER
                </h2>
                <p class="small mb-0">
                    Staff must review identity and business documents before granting
                    access or approving real bookings. Email verification alone does
                    not establish identity or business ownership.
                </p>
            </aside>
        </div>
    </div>
</main>

<footer class="page-footer py-4">
    <div class="container small">
        QistFlow Admin · HTML &amp; Bootstrap classroom project · Sample data
    </div>
</footer>
