@using Qistflow_Semester_Project.Models.ViewModel
@model Product

<article class="card h-100 overflow-hidden qf-product-card">
    <div class="position-relative">
        <img src="@(Model.ImageUrl ?? Url.Content("~/assets/laptop.jpg"))"
             class="product-photo" alt="@Model.Name" loading="lazy" />
        @if (Model.StockQuantity > 0)
        {
            <span class="badge text-bg-success position-absolute top-0 start-0 m-2">
                In Stock (@Model.StockQuantity)
            </span>
        }
        else
        {
            <span class="badge text-bg-danger position-absolute top-0 start-0 m-2">
                Out of Stock
            </span>
        }
    </div>

    <div class="card-body d-flex flex-column p-3">
        <h3 class="serif h4">@Model.Name</h3>

        <div class="price-panel mt-auto mb-3">
            @if (Model.InstallmentMonths > 0)
            {
                <span class="badge text-bg-warning mb-3">
                    Rs. @(Math.Round((Model.InstallmentPrice/Model.InstallmentMonths) - Model.DownPayment)) / month
                </span>
            }
            <p class="small mb-1">Cash price: Rs. @Model.CashPrice.ToString("N0")</p>
            @if (Model.InstallmentPrice > 0)
            {
                <p>Installment plan:</p>
                <strong>Rs. @Model.InstallmentPrice.ToString("N0")</strong>
                <p class="small mb-0">@Model.InstallmentMonths   months · total installment plan</p>
            }
            else
            {
                <strong>Rs. @Model.CashPrice.ToString("N0")</strong>
                <p class="small mb-0">Installment plan not configured yet</p>
            }
        </div>

        <a asp-controller="Products" asp-action="Details"
           asp-route-id="@Model.productId" class="btn btn-success w-100">
            View Details
        </a>


        @if (User.IsInRole("Admin"))
        {
            <form asp-controller="AdminProducts" asp-action="Delete" asp-route-id="@Model.productId" id"deleteForm" method="post" class="js-product-delete mt-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.productId" />
                <button class="btn btn-outline-danger w-100" id="deleteBtn">
                    <i class="bi bi-trash me-1" aria-hidden="true"></i> Delete
                </button>
            </form>
        }
    </div>
</article>
@{
    <script>
        document.querySelector("#deleteBtn").addEventListener("click", function() {
            if (confirm("Are you sure you want to delete this product?")) {
                document.querySelector("#deleteForm").submit();
            }
        });
    </script>

}
