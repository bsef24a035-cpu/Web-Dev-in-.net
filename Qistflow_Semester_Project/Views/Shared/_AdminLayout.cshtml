<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Qistflow_Semester_Project</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Qistflow_Semester_Project.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar container gap-3 py-4">
            <a href="@Url.Action("Index", "Admin")">
                <img src="~/assets/logo.svg" class="brand-logo" alt="QistFlow Admin">
            </a>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <a href="@Url.Action("Index", "Admin")">Dashboard</a>
                <a href="@Url.Action("Stock", "Admin")">Product Stock</a>
                <a href="#requests">Booking Requests</a>
                <span class="small text-secondary">@(User.Identity?.Name)</span>
                <form asp-area="Identity" asp-page="/Account/Logout" method="post"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="btn btn-success">Log Out</button>
                </form>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>