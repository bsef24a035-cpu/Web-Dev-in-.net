@model List<Car>
<html>
    <body>
        <h1 class="text-dark d-flex justify-content-center m-3">Available Cars</h1>
        <div class="row">
        @if (Model.Count == 0)
        {
            <div class="d-flex justify-content-center align-items-center h-100"><p class="fs-2">No Car Available Yet</p></div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-5 d-flex flex-column gap-3 m-2 border rounded-2 shadow p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2>@item.name</h2>
                        <div class="badge bg-success fw-light" style="letter-spacing: 0.05em;">Available</div>
                    </div>
                    <div>PKR @item.pricePerDay /day</div>
                    <form method="post" action="/Cars/BookACar">
                        <input type="hidden" name="id" value="@item.id" />
                        <button type="submit" class="btn btn-primary">Book Car</button>
                    </form>
                </div>        
            }
        }
        </div>
    </body>
</html>
